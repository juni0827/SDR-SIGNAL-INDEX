APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Leave blank to proxy API calls through the Next.js origin. Set only when a
# deployment has a separate public API origin.
NEXT_PUBLIC_API_URL=
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=signal-index
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_SECURE=false
S3_MULTIPART_THRESHOLD_BYTES=16777216
S3_MULTIPART_CHUNK_BYTES=16777216
SESSION_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-another-32-random-characters
SECRET_ENCRYPTION_KEY=replace-with-a-distinct-32-character-secret
TOOL_API_KEY=replace-with-a-local-agent-api-key
FIRST_USER_EMAIL=owner@local.test
FIRST_USER_PASSWORD=change-this-password
ACCOUNT_ALLOWLIST=owner@local.test
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=2147483648
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ASR_MODEL=large-v3
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_BEAM_SIZE=5
ASR_ALTERNATIVE_CANDIDATES=1
ASR_USE_VAD=false
SILERO_VAD_ENABLED=true
VAD_THRESHOLD=0.55
VAD_MINIMUM_SPEECH_MS=250
VAD_MINIMUM_SILENCE_MS=400
VAD_PADDING_MS=180
VAD_MAXIMUM_SEGMENT_SEC=45
VAD_MERGE_SHORTER_THAN_MS=350
SESSION_MERGE_THRESHOLD=0.68
SESSION_WINDOW_SEC=1800
SESSION_FREQUENCY_WINDOW_HZ=20000
SESSION_WEIGHT_TIME=0.25
SESSION_WEIGHT_FREQUENCY=0.20
SESSION_WEIGHT_ACOUSTIC=0.20
SESSION_WEIGHT_CALLSIGN=0.15
SESSION_WEIGHT_NUMBERS=0.12
SESSION_WEIGHT_MESSAGE=0.08
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=local
PIPELINE_VERSION=1.0.0
PARSER_VERSION=1.0.0
CAPTURE_ENABLED=false
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
DEFAULT_RECORDING_RETENTION_DAYS=3650
RETENTION_DELETE_DERIVED_OBJECTS=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Signal Index
WEBAUTHN_ORIGIN=http://localhost:3000
